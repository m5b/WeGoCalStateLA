#!/bin/sh
set -eu

deploy_root=/var/www/wegotocalstatela
archive=$(mktemp /tmp/wego-release.XXXXXX.tar.gz)
release="$deploy_root/releases/$(date -u +%Y%m%dT%H%M%SZ)-$$"

cleanup() {
  rm -f "$archive"
}
trap cleanup EXIT HUP INT TERM

# Limit a compromised deployment credential to a reasonably sized static build.
ulimit -f 102400
cat > "$archive"

# Refuse absolute paths or parent traversal before extracting the archive.
if tar -tzf "$archive" | awk '
  /^\// { bad=1 }
  /(^|\/)\.\.($|\/)/ { bad=1 }
  END { exit bad ? 0 : 1 }
'; then
  echo "Unsafe path in deployment archive" >&2
  exit 1
fi

mkdir -p "$release"
tar -xzf "$archive" -C "$release" --no-same-owner --no-same-permissions
test -f "$release/index.html"
ln -sfn "$release" "$deploy_root/current"
echo "Published $(basename "$release")"

