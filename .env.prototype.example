# Copy this file to .env.prototype and replace both passwords.
MYSQL_DATABASE=wego_development
MYSQL_USER=wego_app
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
DATABASE_URL=mysql://wego_app:replace_with_a_long_random_password@db:3306/wego_development

# Express backend connection settings (kept alongside the MySQL container settings).
DB_USERNAME=wego_app
DB_PASSWORD=replace_with_the_same_value_as_MYSQL_PASSWORD
DB_DATABASE=wego_development
